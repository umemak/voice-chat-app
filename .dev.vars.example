# Cloudflare Account Settings (REQUIRED for Realtime Agents)
ACCOUNT_ID=your-cloudflare-account-id
API_TOKEN=your-cloudflare-api-token

# OpenAI API Key (Embeddings, GPT-4)
OPENAI_API_KEY=sk-...

# Deepgram API Key (STT via Workers AI)
DEEPGRAM_API_KEY=...

# ElevenLabs API Key (Voice Clone TTS - OPTIONAL if using Cloudflare TTS)
ELEVENLABS_API_KEY=...

# D-ID API Key (Lip-sync Video - Optional)
DID_API_KEY=...

# Optional: Custom OpenAI endpoint
# OPENAI_API_BASE=https://api.openai.com/v1
