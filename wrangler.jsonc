{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-02-14",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Note: After creating resources via CLI, update these IDs
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "voice-chat-storage"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "" // Will be filled after creation
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "voice-chat-rag"
    }
  ]
}